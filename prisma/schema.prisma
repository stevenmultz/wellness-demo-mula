generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS (PostgreSQL Strong Typing)
// ============================================================================

enum UserRole {
  USER
  COACH
  PARTNER_ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
}

enum ProgramDifficultyLevel {
  BEGINNER
  MODERATE
  INTERMEDIATE
  ADVANCED
  HIGH_INTENSITY
}

enum ProgramLocationType {
  ONLINE
  HYBRID
}

enum ProgramStatus {
  DRAFT
  OPEN
  PUBLISHED
  DONE
  ARCHIVED
}

enum ProgramDayType {
  TRAINING_DAY
  REST_DAY
  CONNECTION_DAY
  MEETUP_DAY
}

enum CustomTaskType {
  MEASUREMENT
  BENCHMARK
  FORM
  CHECKLIST
  MEDIA_UPLOAD
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AttendanceMode {
  IN_PERSON
  VIRTUAL
}

enum PaymentTransactionStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  DENY
  REFUND_REQUESTED
  REFUND
  MANUAL_APPROVED
}

enum NotificationType {
  PROGRAM
  TASK
  PAYMENT
  REMINDER
  ANNOUNCEMENT
  INFO
}

enum BodyMetricSource {
  CUSTOM_TASK
  ADMIN
  SELF
}

enum SupportRequestType {
  QUIT_COHORT
  REPORT_ISSUE
}

enum SupportRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ProgressShareStatus {
  ACTIVE
  REVOKED
}

enum PaymentItemType {
  PROGRAM_ENROLLMENT
  TRACKING_PASS
}

enum TrackingPassOrderStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

enum TrackingGrantSourceType {
  PROGRAM_BONUS
  STANDALONE_PASS
  ADMIN_COMP
}

enum TrackingGrantStatus {
  ACTIVE
  REVOKED
}

enum DailyMealQualityMode {
  ON_PLAN
  PARTIAL
  OFF_TRACK
  SELF_LOGGED
}

// ============================================================================
// 1. USERS, AUTHENTICATION & ACCESS MANAGEMENT
// ============================================================================

model User {
  id                    String    @id @default(cuid()) @map("id")
  email                 String    @unique @map("email")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  passwordHash          String?   @map("password_hash")
  fullName              String    @map("full_name")
  phone                 String?   @map("phone")
  gender                String?   @map("gender")
  occupation            String?   @map("occupation")
  address               String?   @map("address")
  birthDate             DateTime? @map("birth_date") @db.Date
  avatarPath            String?   @map("avatar_path")
  city                  String?   @map("city")
  province              String?   @map("province")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  role                  UserRole  @default(USER) @map("role")
  status                UserStatus @default(ACTIVE) @map("status")
  preferredLocale       String    @default("id") @map("preferred_locale")
  organizationId        String?   @map("organization_id")
  coachProfileId        String?   @map("coach_profile_id")
  trackingAccessUntil   DateTime? @map("tracking_access_until")
  tokenVersion          Int       @default(0) @map("token_version")
  deletedAt             DateTime? @map("deleted_at")
  deletedById           String?   @map("deleted_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization            MasterOrganization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  coachProfile            MasterCoach?                 @relation(fields: [coachProfileId], references: [id], onDelete: SetNull)
  identities              UserIdentity[]
  emailVerificationTokens UserEmailVerificationToken[]
  passwordResetTokens     UserPasswordResetToken[]
  enrollments             ProgramEnrollment[]
  trackingPassOrders      TrackingPassOrder[]
  trackingGrants          UserTrackingGrant[]
  paymentTransactions     PaymentTransaction[]
  pushSubscriptions       UserPushSubscription[]
  dayProgresses           ProgramDayProgress[]
  dailyLogs               UserDailyLog[]
  extraWorkoutLogs        UserExtraWorkoutLog[]
  customSubmissions       ProgramDayCustomSubmission[]
  bodyMetricLogs          UserBodyMetricLog[]
  notifications           UserNotification[]
  supportRequests         CohortSupportRequest[]
  progressSharesOwned     UserProgressShare[]          @relation("ProgressShareOwner")
  progressSharesReceived  UserProgressShare[]          @relation("ProgressShareViewer")

  @@index([role])
  @@index([status])
  @@index([organizationId])
  @@index([coachProfileId])
  @@index([trackingAccessUntil])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([role, deletedAt, createdAt])
  @@map("users")
}

model UserIdentity {
  id                String       @id @default(cuid()) @map("id")
  userId            String       @map("user_id")
  provider          AuthProvider @map("provider")
  providerAccountId String       @map("provider_account_id")
  email             String?      @map("email")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

model UserEmailVerificationToken {
  id        String    @id @default(cuid()) @map("id")
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_email_verification_tokens")
}

model UserPasswordResetToken {
  id        String   @id @default(cuid()) @map("id")
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

model UserProgressShare {
  id           String              @id @default(cuid()) @map("id")
  ownerUserId  String              @map("owner_user_id")
  viewerEmail  String              @map("viewer_email")
  viewerUserId String?             @map("viewer_user_id")
  label        String?             @map("label")
  status       ProgressShareStatus @default(ACTIVE) @map("status")
  revokedAt    DateTime?           @map("revoked_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  owner  User  @relation("ProgressShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  viewer User? @relation("ProgressShareViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, viewerEmail])
  @@index([viewerEmail, status])
  @@index([viewerUserId, status])
  @@map("user_progress_shares")
}

// ============================================================================
// 2. MASTER DIRECTORIES (STANDALONE CATALOGS)
// ============================================================================

model MasterCategory {
  id        String            @id @default(cuid()) @map("id")
  name      String            @unique @map("name")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  programs  ProgramCategory[]

  @@map("master_categories")
}

model MasterCoach {
  id             String              @id @default(cuid()) @map("id")
  name           String              @map("name")
  title          String              @map("title")
  organizationId String?             @map("organization_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   MasterOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  programs       ProgramCoach[]
  users          User[]

  @@index([name])
  @@index([organizationId])
  @@map("master_coaches")
}

model MasterOrganization {
  id         String            @id @default(cuid()) @map("id")
  name       String            @unique @map("name")
  slug       String            @unique @map("slug")
  tagline    String?           @map("tagline")
  logoPath   String?           @map("logo_path")
  websiteUrl String?           @map("website_url")
  isVerified Boolean           @default(true) @map("is_verified")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  programs   Program[]
  coaches    MasterCoach[]
  users      User[]
  templates  ProgramTemplate[]

  @@map("master_organizations")
}

model MasterEquipment {
  id        String             @id @default(cuid()) @map("id")
  name      String             @unique @map("name")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  programs  ProgramEquipment[]

  @@map("master_equipments")
}

model MasterDailyCommitment {
  id        String    @id @default(cuid()) @map("id")
  name      String    @unique @map("name")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  programs  Program[]

  @@map("master_daily_commitments")
}

// ============================================================================
// 3. PROGRAM DOMAIN (SINGLE 3NF SOURCE OF TRUTH)
// ============================================================================

model Program {
  id                         String                 @id @default(cuid()) @map("id")
  title                      String                 @map("title")
  slug                       String                 @unique @map("slug")
  batchNumber                Int?                   @map("batch_number")
  description                String                 @map("description")
  coverImagePath             String?                @map("cover_image_path")
  introVideoUrl              String?                @map("intro_video_url")
  difficultyLevel            ProgramDifficultyLevel @default(INTERMEDIATE) @map("difficulty_level")
  durationDays               Int                    @default(21) @map("duration_days")

  // Pricing & Quota (Integer IDR)
  actualPrice                Int                    @default(0) @map("actual_price")
  discountPercentage         Int                    @default(0) @map("discount_percentage")
  price                      Int                    @default(0) @map("price")
  bonusTrackingDays          Int                    @default(60) @map("bonus_tracking_days")
  minQuota                   Int                    @default(1) @map("min_quota")
  maxQuota                   Int                    @default(50) @map("max_quota")

  // Community & Logistics
  communityLink              String?                @map("community_link")
  locationType               ProgramLocationType    @default(ONLINE) @map("location_type")
  city                       String?                @map("city")
  venueAddress               String?                @map("venue_address")

  // Schedule Timestamps (Required for HYBRID cohorts; NULL for anytime ONLINE programs)
  startAt                    DateTime?              @map("start_at")
  endAt                      DateTime?              @map("end_at")
  registrationOpenAt         DateTime?              @map("registration_open_at")
  registrationDeadlineAt     DateTime?              @map("registration_deadline_at")

  // Publication Status (Single Authoritative Enum)
  status                     ProgramStatus          @default(DRAFT) @map("status")

  // Relational Foreign Keys
  dailyCommitmentId          String?                @map("daily_commitment_id")
  dailyCommitmentRef         MasterDailyCommitment? @relation(fields: [dailyCommitmentId], references: [id], onDelete: SetNull)
  organizationId             String?                @map("organization_id")
  organization               MasterOrganization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Blueprint & Custom Terms (Native jsonb)
  customTerms                String?                @map("custom_terms")
  targetState                String?                @map("target_state")
  methodology                String?                @map("methodology")
  expectedBenefitsJson       Json?                  @map("expected_benefits_json")
  scientificReferencesJson   Json?                  @map("scientific_references_json")
  programGuidelinesJson      Json?                  @map("program_guidelines_json")

  // Concurrency & Lifecycle
  version                    Int                    @default(1) @map("version")
  deletedAt                  DateTime?              @map("deleted_at")
  deletedById                String?                @map("deleted_by_id")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")

  categories                 ProgramCategory[]
  coaches                    ProgramCoach[]
  equipments                 ProgramEquipment[]
  days                       ProgramDay[]
  enrollments                ProgramEnrollment[]
  paymentTransactions        PaymentTransaction[]
  bodyMetricLogs             UserBodyMetricLog[]
  supportRequests            CohortSupportRequest[]

  @@index([status, startAt])
  @@index([status, createdAt])
  @@index([status, deletedAt, createdAt])
  @@index([status, deletedAt, price])
  @@index([status, deletedAt, startAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([locationType, status])
  @@index([dailyCommitmentId])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("programs")
}

// ============================================================================
// 4. PROGRAM TAXONOMY PIVOT TABLES (3NF)
// ============================================================================

model ProgramCategory {
  programId  String         @map("program_id")
  categoryId String         @map("category_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  program  Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  category MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([programId, categoryId])
  @@index([categoryId])
  @@map("program_categories")
}

model ProgramCoach {
  programId String      @map("program_id")
  coachId   String      @map("coach_id")
  createdAt DateTime    @default(now()) @map("created_at")

  program Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  coach   MasterCoach @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@id([programId, coachId])
  @@index([coachId])
  @@map("program_coaches")
}

model ProgramEquipment {
  programId   String          @map("program_id")
  equipmentId String          @map("equipment_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  program   Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  equipment MasterEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([programId, equipmentId])
  @@index([equipmentId])
  @@map("program_equipments")
}

// ============================================================================
// 5. PROGRAM CURRICULUM & CUSTOM TASKS
// ============================================================================

enum ProgramTemplateType {
  PROGRAM_HEADER
  DAY_ROUTINE
}

model ProgramTemplate {
  id             String              @id @default(cuid()) @map("id")
  organizationId String?             @map("organization_id")
  templateType   ProgramTemplateType @map("template_type")
  name           String              @map("name")
  description    String?             @map("description")
  payloadJson    Json                @map("payload_json")
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization MasterOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, templateType])
  @@index([templateType])
  @@map("program_templates")
}

model ProgramDay {
  id                   String         @id @default(cuid()) @map("id")
  programId            String         @map("program_id")
  dayNumber            Int            @map("day_number")
  title                String         @map("title")
  dayType              ProgramDayType @default(TRAINING_DAY) @map("day_type")
  workoutOptionsJson   Json?          @map("workout_options_json")
  sleepRecommendation  String?        @map("sleep_recommendation")
  dayNotificationsJson Json?          @map("day_notifications_json")
  videoUrl             String?        @map("video_url")
  videoChecklistJson   Json?          @map("video_checklist_json")
  mealRecommendation   String?        @map("meal_recommendation")
  meetupLink           String?        @map("meetup_link")
  mapLink              String?        @map("map_link")
  onsiteVenue          String?        @map("onsite_venue")
  onsiteSchedule       String?        @map("onsite_schedule")
  eventTitle           String?        @map("event_title")
  eventHost            String?        @map("event_host")
  eventDetails         String?        @map("event_details")
  restInstructions     String?        @map("rest_instructions")
  version              Int            @default(1) @map("version")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  program           Program                      @relation(fields: [programId], references: [id], onDelete: Cascade)
  progresses        ProgramDayProgress[]
  customTasks       ProgramDayCustomTask[]
  customSubmissions ProgramDayCustomSubmission[]
  bodyMetricLogs    UserBodyMetricLog[]

  @@unique([programId, dayNumber])
  @@index([programId])
  @@map("program_days")
}

model ProgramDayCustomTask {
  id               String         @id @default(cuid()) @map("id")
  programDayId     String         @map("program_day_id")
  sortOrder        Int            @default(0) @map("sort_order")
  taskType         CustomTaskType @map("task_type")
  title            String         @map("title")
  instructions     String?        @map("instructions")
  isRequired       Boolean        @default(true) @map("is_required")
  fieldsSchemaJson Json           @map("fields_schema_json")
  translationsJson Json?          @map("translations_json")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  programDay  ProgramDay                   @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  submissions ProgramDayCustomSubmission[]

  @@index([programDayId, sortOrder])
  @@map("program_day_custom_tasks")
}

model ProgramDayCustomSubmission {
  id           String   @id @default(cuid()) @map("id")
  userId       String   @map("user_id")
  programDayId String   @map("program_day_id")
  customTaskId String   @map("custom_task_id")
  valuesJson   Json     @map("values_json")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDay ProgramDay           @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  customTask ProgramDayCustomTask @relation(fields: [customTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, customTaskId])
  @@index([userId, programDayId])
  @@index([programDayId])
  @@index([customTaskId])
  @@map("program_day_custom_submissions")
}

model UserBodyMetricLog {
  id           String           @id @default(cuid()) @map("id")
  userId       String           @map("user_id")
  programId    String?          @map("program_id")
  programDayId String?          @map("program_day_id")
  source       BodyMetricSource @default(CUSTOM_TASK) @map("source")
  weightKg     Float?           @map("weight_kg")
  heightCm     Float?           @map("height_cm")
  waistCm      Float?           @map("waist_cm")
  chestCm      Float?           @map("chest_cm")
  hipsCm       Float?           @map("hips_cm")
  bodyFatPct   Float?           @map("body_fat_pct")
  restingHr    Int?             @map("resting_hr")
  notes        String?          @map("notes")
  recordedAt   DateTime         @default(now()) @map("recorded_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  programDay ProgramDay? @relation(fields: [programDayId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([userId, programId])
  @@index([userId, programDayId, source])
  @@map("user_body_metric_logs")
}

// ============================================================================
// 6. TRANSACTIONS, ENROLLMENTS & SUPPORT REQUESTS
// ============================================================================

model ProgramEnrollment {
  id                 String           @id @default(cuid()) @map("id")
  userId             String           @map("user_id")
  programId          String           @map("program_id")
  status             EnrollmentStatus @default(PENDING) @map("status")
  attendanceMode     AttendanceMode   @default(VIRTUAL) @map("attendance_mode")
  paymentReference   String?          @unique @map("payment_reference")
  invoiceExpiresAt   DateTime?        @map("invoice_expires_at")
  paidAt             DateTime?        @map("paid_at")
  validUntilAt       DateTime?        @map("valid_until_at")

  // Legal Consent & Admin Approval Audit Trail
  termsAgreedAt      DateTime?        @map("terms_agreed_at")
  termsAgreedVersion String?          @default("v1.0") @map("terms_agreed_version")
  approvedById       String?          @map("approved_by_id")
  approvedAt         DateTime?        @map("approved_at")
  cancellationReason String?          @map("cancellation_reason")

  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  program         Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  transactions    PaymentTransaction[]
  supportRequests CohortSupportRequest[]
  trackingGrant   UserTrackingGrant?

  @@unique([userId, programId])
  @@index([programId, status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, invoiceExpiresAt])
  @@index([createdAt])
  @@map("program_enrollments")
}

model TrackingPassPlan {
  id                 String   @id @default(cuid()) @map("id")
  slug               String   @unique @map("slug")
  name               String   @map("name")
  description        String?  @map("description")
  durationDays       Int      @default(180) @map("duration_days")
  actualPrice        Int      @default(500000) @map("actual_price")
  discountPercentage Int      @default(0) @map("discount_percentage")
  price              Int      @default(500000) @map("price")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  customTerms        String?  @map("custom_terms")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  orders TrackingPassOrder[]

  @@index([isActive, sortOrder])
  @@map("tracking_pass_plans")
}

model TrackingPassOrder {
  id                   String                  @id @default(cuid()) @map("id")
  userId               String                  @map("user_id")
  planId               String                  @map("plan_id")
  status               TrackingPassOrderStatus @default(PENDING) @map("status")
  paymentReference     String?                 @unique @map("payment_reference")
  invoiceExpiresAt     DateTime?               @map("invoice_expires_at")
  paidAt               DateTime?               @map("paid_at")
  durationDaysSnapshot Int                     @map("duration_days_snapshot")
  priceSnapshot        Int                     @map("price_snapshot")
  termsAgreedAt        DateTime?               @map("terms_agreed_at")
  termsAgreedVersion   String?                 @default("v1.0") @map("terms_agreed_version")
  approvedById         String?                 @map("approved_by_id")
  approvedAt           DateTime?               @map("approved_at")
  cancellationReason   String?                 @map("cancellation_reason")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan          TrackingPassPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]
  trackingGrant UserTrackingGrant?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, invoiceExpiresAt])
  @@index([planId])
  @@map("tracking_pass_orders")
}

model UserTrackingGrant {
  id                  String                  @id @default(cuid()) @map("id")
  userId              String                  @map("user_id")
  sourceType          TrackingGrantSourceType @map("source_type")
  status              TrackingGrantStatus     @default(ACTIVE) @map("status")
  programEnrollmentId String?                 @unique @map("program_enrollment_id")
  trackingPassOrderId String?                 @unique @map("tracking_pass_order_id")
  durationDays        Int                     @map("duration_days")
  startsAt            DateTime                @map("starts_at")
  endsAt              DateTime                @map("ends_at")
  grantedById         String?                 @map("granted_by_id")
  revokedAt           DateTime?               @map("revoked_at")
  revokeReason        String?                 @map("revoke_reason")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  programEnrollment ProgramEnrollment? @relation(fields: [programEnrollmentId], references: [id], onDelete: SetNull)
  trackingPassOrder TrackingPassOrder? @relation(fields: [trackingPassOrderId], references: [id], onDelete: SetNull)

  @@index([userId, status, endsAt])
  @@index([status, endsAt])
  @@map("user_tracking_grants")
}

model PaymentTransaction {
  id                   String                   @id @default(cuid()) @map("id")
  itemType             PaymentItemType          @default(PROGRAM_ENROLLMENT) @map("item_type")
  enrollmentId         String?                  @map("enrollment_id")
  trackingPassOrderId  String?                  @map("tracking_pass_order_id")
  userId               String                   @map("user_id")
  programId            String?                  @map("program_id")
  orderId              String                   @unique @map("order_id")
  gatewayTransactionId String?                  @map("gateway_transaction_id")
  provider             String                   @map("provider")
  paymentType          String                   @default("qris") @map("payment_type")
  grossAmount          Int                      @map("gross_amount")
  status               PaymentTransactionStatus @default(PENDING) @map("status")
  qrisStringOrUrl      String?                  @map("qris_string_or_url")
  rawWebhookJson       Json?                    @map("raw_webhook_json")
  expiresAt            DateTime?                @map("expires_at")
  settledAt            DateTime?                @map("settled_at")
  refundAmount         Int?                     @map("refund_amount")
  refundFeeAmount      Int?                     @map("refund_fee_amount")
  refundReason         String?                  @map("refund_reason")
  refundedAt           DateTime?                @map("refunded_at")
  refundedById         String?                  @map("refunded_by_id")
  createdById          String?                  @map("created_by_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  enrollment        ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  trackingPassOrder TrackingPassOrder? @relation(fields: [trackingPassOrderId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  program           Program?           @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([enrollmentId, status, createdAt])
  @@index([trackingPassOrderId, status, createdAt])
  @@index([itemType, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([programId, status])
  @@map("payment_transactions")
}

model CohortSupportRequest {
  id           String               @id @default(cuid()) @map("id")
  userId       String               @map("user_id")
  programId    String               @map("program_id")
  enrollmentId String?              @map("enrollment_id")
  requestType  SupportRequestType   @map("request_type")
  reasonCode   String               @map("reason_code")
  note         String               @map("note")
  status       SupportRequestStatus @default(OPEN) @map("status")
  adminNote    String?              @map("admin_note")
  resolvedById String?              @map("resolved_by_id")
  resolvedAt   DateTime?            @map("resolved_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollment ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([programId, status])
  @@index([status, createdAt])
  @@map("cohort_support_requests")
}

// ============================================================================
// 7. USER PROGRESS, TELEMETRY, AUDIT & DISTRIBUTED RATE LIMITING
// ============================================================================

model ProgramDayProgress {
  id                     String    @id @default(cuid()) @map("id")
  userId                 String    @map("user_id")
  programDayId           String    @map("program_day_id")
  isVideoWatched         Boolean   @default(false) @map("is_video_watched")
  isCompleted            Boolean   @default(false) @map("is_completed")
  checklistCompletedJson Json?     @map("checklist_completed_json")
  selectedWorkout        String?   @map("selected_workout")
  workoutNotes           String?   @map("workout_notes")
  eventFeedback          String?   @map("event_feedback")
  mealCompliance         String?   @map("meal_compliance")
  mealNotes              String?   @map("meal_notes")
  dailyReflection        String?   @map("daily_reflection")
  happinessRate          Int?      @map("happiness_rate")
  bedtime                String?   @map("bedtime")
  wakeTime               String?   @map("wake_time")
  sleepDurationMinutes   Int?      @map("sleep_duration_minutes")
  assessmentResponse     String?   @map("assessment_response")
  completedAt            DateTime? @map("completed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDay ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)

  @@unique([userId, programDayId])
  @@index([programDayId])
  @@index([programDayId, completedAt])
  @@index([userId, isCompleted])
  @@index([userId, completedAt])
  @@map("program_day_progresses")
}

model UserDailyLog {
  id                   String                @id @default(cuid()) @map("id")
  userId               String                @map("user_id")
  logDate              DateTime              @map("log_date") @db.Date
  // Universal Sleep Biomarkers
  bedtime              String?               @map("bedtime")
  wakeTime             String?               @map("wake_time")
  sleepDurationMinutes Int?                  @map("sleep_duration_minutes")
  sleepFeeling         String?               @map("sleep_feeling")
  // Universal Hydration
  waterMl              Int                   @default(0) @map("water_ml")
  // Universal Daily Steps
  stepsCount           Int                   @default(0) @map("steps_count")
  stepsBurnedKcal      Int                   @default(0) @map("steps_burned_kcal")
  // Universal Objective Meal Intake
  mealsCount           Int?                  @map("meals_count")
  caloriesKcal         Int                   @default(0) @map("calories_kcal")
  carbsG               Int                   @default(0) @map("carbs_g")
  proteinG             Int                   @default(0) @map("protein_g")
  fatG                 Int                   @default(0) @map("fat_g")
  mealQualityMode      DailyMealQualityMode? @map("meal_quality_mode")
  mealFeeling          String?               @map("meal_feeling")
  mealEntriesJson      Json?                 @map("meal_entries_json")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraWorkouts UserExtraWorkoutLog[]

  @@unique([userId, logDate])
  @@index([userId, logDate(sort: Desc)])
  @@map("user_daily_logs")
}

model UserExtraWorkoutLog {
  id                 String   @id @default(cuid()) @map("id")
  dailyLogId         String   @map("daily_log_id")
  userId             String   @map("user_id")
  activityType       String   @map("activity_type")
  title              String   @map("title")
  durationMinutes    Int      @map("duration_minutes")
  estimatedKcal      Int      @map("estimated_kcal")
  excludeFromNetBurn Boolean  @default(false) @map("exclude_from_net_burn")
  notes              String?  @map("notes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  dailyLog UserDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@index([userId, createdAt])
  @@map("user_extra_workout_logs")
}

model UserPushSubscription {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  endpoint  String   @unique @map("endpoint")
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_push_subscriptions")
}

model UserNotification {
  id        String           @id @default(cuid()) @map("id")
  userId    String           @map("user_id")
  type      NotificationType @default(INFO) @map("type")
  title     String           @map("title")
  body      String           @map("body")
  url       String?          @map("url")
  dedupeKey String?          @map("dedupe_key")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notifications")
}

model AuditLog {
  id           String   @id @default(cuid()) @map("id")
  actorUserId  String?  @map("actor_user_id")
  action       String   @map("action")
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadataJson Json?    @map("metadata_json")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitBucket {
  key           String   @id @map("key")
  hits          Int      @default(1) @map("hits")
  windowStartAt DateTime @map("window_start_at")
  expiresAt     DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
