{
  "specification": "Production Live Monitoring Metrics Specification",
  "project": "wellness-pwa",
  "targetUptime": "99.9%",
  "metrics": [
    {
      "id": 1,
      "name": "Uptime",
      "definition": "Percentage of successful HTTP 200 responses to health endpoint",
      "source": "Synthetic Monitor (BetterUptime / Datadog)",
      "frequency": "60s",
      "thresholdNormal": ">= 99.9%",
      "thresholdWarning": "< 99.5%",
      "thresholdCritical": "< 99.0%",
      "alert": "PagerDuty / Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 2,
      "name": "SSL/TLS Status",
      "definition": "Valid TLS 1.3 handshake verification",
      "source": "Edge SSL Probe",
      "frequency": "1h",
      "thresholdNormal": "TLS 1.3 Valid",
      "thresholdWarning": "TLS < 1.3",
      "thresholdCritical": "Invalid / Expired",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 3,
      "name": "SSL Expiration",
      "definition": "Days remaining before TLS certificate expiration",
      "source": "Cert Monitor Cron",
      "frequency": "24h",
      "thresholdNormal": "> 30 Days",
      "thresholdWarning": "<= 14 Days",
      "thresholdCritical": "<= 3 Days",
      "alert": "Slack / Email",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 4,
      "name": "HTTPS Enforcement",
      "definition": "Verification of 301/308 redirect from HTTP to HTTPS",
      "source": "Synthetic HTTP Probe",
      "frequency": "6h",
      "thresholdNormal": "301 Redirect",
      "thresholdWarning": "200 over HTTP",
      "thresholdCritical": "Plain HTTP Open",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 5,
      "name": "Security Headers",
      "definition": "Verification of HSTS, CSP, X-Frame-Options, nosniff presence",
      "source": "SecurityHeader CI Probe",
      "frequency": "24h",
      "thresholdNormal": "All Present (Grade A)",
      "thresholdWarning": "1 Header Missing",
      "thresholdCritical": "CSP/HSTS Missing",
      "alert": "Slack (#security)",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 6,
      "name": "Failed Authentication",
      "definition": "Count of failed sign-in attempts per minute",
      "source": "App Security Logs (wellnessSignIn)",
      "frequency": "1m",
      "thresholdNormal": "< 10 / min",
      "thresholdWarning": "10 - 50 / min",
      "thresholdCritical": "> 50 / min",
      "alert": "Slack / PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 7,
      "name": "Rate Limit Hits",
      "definition": "Frequency of HTTP 429 Too Many Requests responses",
      "source": "Rate Limit Telemetry",
      "frequency": "1m",
      "thresholdNormal": "< 5 / min",
      "thresholdWarning": "5 - 30 / min",
      "thresholdCritical": "> 30 / min",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 8,
      "name": "Suspicious Traffic",
      "definition": "Requests triggering WAF security rules",
      "source": "Vercel / Cloudflare WAF",
      "frequency": "Real-time",
      "thresholdNormal": "0 / min",
      "thresholdWarning": "1 - 10 / min",
      "thresholdCritical": "> 10 / min",
      "alert": "Slack / Security On-Call",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 9,
      "name": "Bot / Scraper Traffic",
      "definition": "Percentage of total traffic matching scraper user agents",
      "source": "Edge WAF Analytics",
      "frequency": "1h",
      "thresholdNormal": "< 5%",
      "thresholdWarning": "5% - 20%",
      "thresholdCritical": "> 20%",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 10,
      "name": "Dependency CVEs",
      "definition": "Identified vulnerabilities in package dependencies",
      "source": "GitHub Dependabot / Snyk",
      "frequency": "24h",
      "thresholdNormal": "0 CVE",
      "thresholdWarning": "1+ Medium",
      "thresholdCritical": "1+ High / Critical",
      "alert": "GitHub Issue / Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 11,
      "name": "Database Backup Status",
      "definition": "Success confirmation of scheduled daily database backup",
      "source": "Supabase Backup Webhook",
      "frequency": "24h",
      "thresholdNormal": "100% Success",
      "thresholdWarning": "Skipped",
      "thresholdCritical": "Failed",
      "alert": "PagerDuty (High Priority)",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 12,
      "name": "API Availability",
      "definition": "Uptime percentage of REST API endpoints",
      "source": "Synthetic API Monitor",
      "frequency": "2m",
      "thresholdNormal": ">= 99.9%",
      "thresholdWarning": "< 99.5%",
      "thresholdCritical": "< 99.0%",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 13,
      "name": "API Latency (P95)",
      "definition": "95th percentile response latency for API endpoints",
      "source": "APM (Sentry / Datadog)",
      "frequency": "5m",
      "thresholdNormal": "< 300 ms",
      "thresholdWarning": "300 - 800 ms",
      "thresholdCritical": "> 800 ms",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 14,
      "name": "HTTP Error Rate",
      "definition": "Percentage of HTTP 5xx responses",
      "source": "Vercel Analytics / APM",
      "frequency": "1m",
      "thresholdNormal": "< 0.1%",
      "thresholdWarning": "0.1% - 1.0%",
      "thresholdCritical": "> 1.0%",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 15,
      "name": "CPU Usage",
      "definition": "Compute utilization percentage on server and DB",
      "source": "Cloud Infrastructure Metrics",
      "frequency": "60s",
      "thresholdNormal": "< 60%",
      "thresholdWarning": "60% - 80%",
      "thresholdCritical": "> 80%",
      "alert": "Slack / PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 16,
      "name": "Memory Usage",
      "definition": "RAM utilization percentage on database and lambdas",
      "source": "Cloud Infrastructure Metrics",
      "frequency": "60s",
      "thresholdNormal": "< 70%",
      "thresholdWarning": "70% - 85%",
      "thresholdCritical": "> 85%",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 17,
      "name": "Disk Usage",
      "definition": "Storage capacity consumption percentage on PostgreSQL",
      "source": "Supabase Disk Metrics",
      "frequency": "1h",
      "thresholdNormal": "< 70%",
      "thresholdWarning": "70% - 85%",
      "thresholdCritical": "> 85%",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 18,
      "name": "Database Health",
      "definition": "Latency and liveness of SELECT 1 probe query",
      "source": "Prisma Health Check Probe",
      "frequency": "30s",
      "thresholdNormal": "< 50 ms",
      "thresholdWarning": "50 - 200 ms",
      "thresholdCritical": "Timeout / Down",
      "alert": "PagerDuty (CRITICAL)",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 19,
      "name": "Slow Queries",
      "definition": "Queries taking longer than 250ms to complete",
      "source": "PostgreSQL pg_stat_statements",
      "frequency": "1h",
      "thresholdNormal": "0 / hour",
      "thresholdWarning": "1 - 5 / hour",
      "thresholdCritical": "> 5 / hour",
      "alert": "Slack (#engineering)",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 20,
      "name": "Database Connections",
      "definition": "Active pooler connections vs maximum allocation",
      "source": "Supabase PgBouncer Pooler Metrics",
      "frequency": "60s",
      "thresholdNormal": "< 50%",
      "thresholdWarning": "50% - 80%",
      "thresholdCritical": "> 80%",
      "alert": "Slack / PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 21,
      "name": "Cache Hit Ratio",
      "definition": "Percentage of requests satisfied by Edge CDN cache",
      "source": "Vercel / Cloudflare Cache Analytics",
      "frequency": "24h",
      "thresholdNormal": "> 85%",
      "thresholdWarning": "70% - 85%",
      "thresholdCritical": "< 70%",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 22,
      "name": "Storage Health",
      "definition": "Availability and write success rate to media storage",
      "source": "Storage Bucket Health Monitor",
      "frequency": "5m",
      "thresholdNormal": "100%",
      "thresholdWarning": "< 99%",
      "thresholdCritical": "Storage Unreachable",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 23,
      "name": "Queue / Cron Health",
      "definition": "Execution completion of scheduled notification cron",
      "source": "Vercel Cron Execution Logs",
      "frequency": "Per Run",
      "thresholdNormal": "Success (Exit 0)",
      "thresholdWarning": "Duration > 55s",
      "thresholdCritical": "Failed / Missed",
      "alert": "Slack / PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 24,
      "name": "CDN Edge Health",
      "definition": "Edge PoP packet loss and response latency",
      "source": "Global Anycast Synthetic Monitor",
      "frequency": "5m",
      "thresholdNormal": "100% Reachable",
      "thresholdWarning": "< 99.5%",
      "thresholdCritical": "Edge PoP Down",
      "alert": "PagerDuty",
      "status": "NOT IMPLEMENTED"
    },
    {
      "id": 25,
      "name": "Network Latency",
      "definition": "Round-trip ping between Next.js server and Supabase DB",
      "source": "Internal Cloud Ping Probe",
      "frequency": "5m",
      "thresholdNormal": "< 15 ms",
      "thresholdWarning": "15 - 50 ms",
      "thresholdCritical": "> 50 ms",
      "alert": "Slack",
      "status": "NOT IMPLEMENTED"
    }
  ]
}
